{
  "name": "takeshi-bot",
  "version": "8.11.0",
  "description": "Um bot de WhatsApp multifunções.",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "build:tests": "node ./node_modules/typescript/bin/tsc -p tsconfig.tests.json",
    "start": "npm run build && node ./dist/src/index.js",
    "test": "npm run build && npm run build:tests && node ./dist/src/test.js",
    "test:all": "npm run build && npm run build:tests && node --test --test-concurrency=1 dist/src/test",
    "patch:baileys": "node ./scripts/patch-baileys.mjs",
    "postinstall": "node ./scripts/patch-baileys.mjs"
  },
  "engines": {
    "node": ">=22.8.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@cacheable/node-cache": "^3.0.0",
    "axios": "^1.14.0",
    "baileys": "7.0.0-rc14",
    "correios-brasil": "^3.0.6",
    "node-cache": "^5.1.2",
    "node-webpmux": "^3.2.1",
    "openai": "^6.33.0",
    "pino": "^10.3.1",
    "tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}